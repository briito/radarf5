---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contato - Radar F5"
  description="Entre em contato com o Radar F5 para enviar dúvidas, sugestões, correções, sugestões de pauta ou propostas de parceria."
>
  <section class="container hero-section">
    <h1>Fale Conosco</h1>

    <p>
      Tem alguma dúvida sobre nossos conteúdos, sugestão de pauta, encontrou
      alguma informação que precisa ser corrigida ou deseja falar sobre uma
      possível parceria? Entre em contato com nossa equipe.
    </p>

    <div class="callout-box">
      <p>
        <strong>E-mail:</strong> radarf5web@gmail.com
      </p>
    </div>

    <section
      class="offer-card"
      style="border-color: var(--border-color); display: block;"
    >
      <form
        class="contact-form"
        id="contact-form"
        action="/api/contact"
        method="POST"
        style="display: flex; flex-direction: column; gap: 15px;"
      >
        <div>
          <label
            for="nome"
            style="display: block; font-weight: bold; margin-bottom: 5px;"
          >
            Seu Nome:
          </label>

          <input
            type="text"
            id="nome"
            name="nome"
            required
            style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px;"
          />
        </div>

        <div>
          <label
            for="email"
            style="display: block; font-weight: bold; margin-bottom: 5px;"
          >
            Seu E-mail:
          </label>

          <input
            type="email"
            id="email"
            name="email"
            required
            style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px;"
          />
        </div>

        <div>
          <label
            for="mensagem"
            style="display: block; font-weight: bold; margin-bottom: 5px;"
          >
            Mensagem:
          </label>

          <textarea
            id="mensagem"
            name="mensagem"
            rows="5"
            required
            style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px;"
          ></textarea>
        </div>

        <div
          aria-hidden="true"
          style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;"
        >
          <label for="website">Deixe este campo em branco:</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <button type="submit" class="btn btn-primary">
            Enviar Mensagem
          </button>
        </div>
      </form>
    </section>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector("#contact-form");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const formElement = event.currentTarget;

    if (!(formElement instanceof HTMLFormElement)) return;

    const button = formElement.querySelector("button[type='submit']");

    const formData = new FormData(formElement);

    if (button instanceof HTMLButtonElement) {
      button.disabled = true;
      button.textContent = "Enviando...";
    }

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        body: formData,
      });

      const result = await response.json();

      if (result.success) {
        alert("Mensagem enviada com sucesso!");
        formElement.reset();
      } else {
        alert(result.message || "Não foi possível enviar a mensagem.");
      }
    } catch (error) {
      console.error(error);
      alert("Ocorreu um erro. Tente novamente.");
    } finally {
      if (button instanceof HTMLButtonElement) {
        button.disabled = false;
        button.textContent = "Enviar Mensagem";
      }
    }
  });
</script>
