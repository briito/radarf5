---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const articles = await getCollection("articles", ({ data }) => {
  return data.draft !== true;
});
---

<BaseLayout
  title="Radar F5 — Review, comparativo e guia de compras"
  description="Review, comparativo e guia de compras para ajudar você com a melhor escolha antes de comprar."
>
  <section class="container hero-section">
    <div class="callout-box">
      <h1>Review, comparativo e guia de compras</h1>

      <p>
        Seja bem-vindo ao <strong>Radar F5</strong>.
      </p>

      <p>
        Análise imparcial e comparativo do que realmente importa antes de escolher.
      </p>

      <p>
        destaque das principais características que precisamos saber antes de fazer a escolha mais segura e acertar na compra.
      </p>
    </div>
  </section>

  <section class="container articles-grid">
    <h2>Artigos em Destaque</h2>

    {
      articles.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          category={article.data.category}
          image={article.data.image}
          imageAlt={article.data.imageAlt}
          href={`/artigos/${article.data.slug}/`}
        />
      ))
    }
  </section>
</BaseLayout>
