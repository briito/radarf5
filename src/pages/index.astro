---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const articles = await getCollection("articles", ({ data }) => {
  return data.draft !== true;
});
---

<BaseLayout
  title="Radar F5 — Inteligência Artificial Aplicada a Negócios Digitais"
  description="Ferramentas de IA, prompts e automações explicados de forma prática para quem quer aplicar no próprio negócio digital."
>
  <section class="container hero-section">
    <div class="callout-box">
      <h1>Inteligência Artificial Aplicada a Negócios Digitais</h1>

      <p>
        Bem-vindo(a) ao <strong>Radar F5</strong>.
      </p>

      <p>
        Menos teoria, mais aplicação: ferramentas de IA, prompts e
        automações explicados na prática para quem quer economizar tempo,
        ganhar produtividade e criar oportunidades no digital.
      </p>
    </div>
  </section>

  <section class="container articles-grid">
    <h2>Artigos em Destaque</h2>

    {
      articles.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          category={article.data.category}
          image={article.data.image}
          imageAlt={article.data.imageAlt}
          href={`/artigos/${article.data.slug}/`}
        />
      ))
    }
  </section>
</BaseLayout>
