---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const articles = await getCollection("articles");
---

<BaseLayout
  title="Radar F5 — Tecnologia, inovação e guias de compra"
  description="Radar F5 — análises de tecnologia, notebooks, hardware, periféricos e guias para ajudar você a fazer melhores escolhas."
>
  <section class="container hero-section">
    <div class="callout-box">
      <h1>As Melhores Análises de Tecnologia em 2026</h1>

      <p>
        Seja bem-vindo ao <strong>Radar F5</strong>. Nosso objetivo é simplificar
        a escolha de hardware, notebooks e periféricos através de análises
        técnicas objetivas e seleção diária de ofertas atrativas.
      </p>
    </div>
  </section>

  <section class="container articles-grid">
    <h2>Artigos e Guias em Destaque</h2>

    {articles.map((article) => (
      <ArticleCard
        title={article.data.title}
        description={article.data.description}
        category={article.data.category}
        image={article.data.image}
        imageAlt={article.data.imageAlt}
        href={`/artigos/${article.id}/`}
      />
    ))}
  </section>
</BaseLayout>