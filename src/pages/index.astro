---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const articles = await getCollection("articles", ({ data }) => {
  return data.draft !== true && data.language === "pt";
});
---

<BaseLayout
  title="Radar F5 — Reviews, Comparativos e Guias de Compra"
  description="Reviews, comparativos e guias de compra para ajudar você a escolher melhor antes de comprar."
>
  <section class="container hero-section">
    <div class="callout-box">
      <h1>Reviews, comparativos e guias de compra</h1>

      <p>
        Seja bem-vindo ao <strong>Radar F5</strong>.
      </p>

      <p>
        Analisamos produtos, comparamos suas características e mostramos os
        principais pontos que você deve considerar antes de comprar.
      </p>
    </div>
  </section>

  <section class="container articles-grid">
    <h2>Artigos em Destaque</h2>

    {
      articles.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          category={article.data.category}
          image={article.data.image}
          imageAlt={article.data.imageAlt}
          href={`/artigos/${article.id}/`}
        />
      ))
    }
  </section>
</BaseLayout>
