---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const articles = await getCollection("articles", ({ data }) => {
    return data.draft !== true && data.language === "pt";
});
---

<BaseLayout
    title="Artigos - Radar F5"
    description="Confira os reviews, comparativos e guias de compra do Radar F5."
>
    <section class="container hero-section">
        <div class="callout-box">
            <h1>Artigos</h1>

            <p>
                Reviews, comparativos e guias de compra para ajudar você a
                escolher melhor antes de comprar.
            </p>
        </div>
    </section>

    <section class="container articles-grid">
        <h2>Todos os Artigos</h2>

        {
            articles.map((article) => (
                <ArticleCard
                    title={article.data.title}
                    description={article.data.description}
                    category={article.data.category}
                    image={article.data.image}
                    imageAlt={article.data.imageAlt}
                    href={`/artigos/${article.id}/`}
                />
            ))
        }
    </section>
</BaseLayout>
