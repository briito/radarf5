---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CategoryNav from "../../components/CategoryNav.astro";

const articles = (await getCollection("articles", ({ data }) => {
    return data.draft !== true;
})).sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<BaseLayout
    title="Artigos - Radar F5"
    description="Guias, tutoriais e prompts de IA para pequenos negócios: conteúdo, Instagram, atendimento, vendas e produtividade, explicados de forma simples."
>
    <section class="container hero-section">
        <div class="callout-box">
            <h1>Artigos</h1>

            <p>
                Guias práticos sobre IA e redes sociais para pequenos
                negócios: conteúdo, Instagram, atendimento, vendas e
                produtividade.
            </p>
        </div>
    </section>

    <section class="container articles-grid">
        <CategoryNav />

        <h2>Todos os Artigos</h2>

        {
            articles.length === 0 ? (
                <p class="empty-state">
                    Estamos preparando os primeiros conteúdos sobre IA e
                    redes sociais para pequenos negócios. Volte em breve!
                </p>
            ) : (
                articles.map((article) => (
                    <ArticleCard
                        title={article.data.title}
                        description={article.data.description}
                        category={article.data.category}
                        image={article.data.image}
                        imageAlt={article.data.imageAlt}
                        href={`/artigos/${article.data.slug}/`}
                    />
                ))
            )
        }
    </section>
</BaseLayout>
