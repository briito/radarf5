---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const articles = await getCollection("articles", ({ data }) => {
    return data.draft !== true && data.language === "en";
});
---

<BaseLayout
    title="Radar F5 — Reviews, Comparisons and Buying Guides"
    description="Reviews, comparisons and buying guides to help you make better purchasing decisions."
    lang="en"
    locale="en_US"
>
    <section class="container hero-section">
        <div class="callout-box">
            <h1>Reviews, Comparisons and Buying Guides</h1>

            <p>Welcome to <strong>Radar F5</strong>.</p>

            <p>
                We analyze products, compare their features and highlight the
                main points you should consider before making a purchase.
            </p>
        </div>
    </section>

    <section class="container articles-grid">
        <h2>Featured Articles</h2>

        {
            articles.length > 0 ? (
                articles.map((article) => (
                    <ArticleCard
                        title={article.data.title}
                        description={article.data.description}
                        category={article.data.category}
                        image={article.data.image}
                        imageAlt={article.data.imageAlt}
                        href={`/en/articles/${article.id}/`}
                    />
                ))
            ) : (
                <p>Our English articles will be available here soon.</p>
            )
        }
    </section>
</BaseLayout>
