---
import BaseLayout from "./BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import ArticleCTA from "../components/ArticleCTA.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import { categoryHref } from "../lib/categories";

interface Props {
  title: string;
  description: string;
  author: string;
  pubDate: string;
  updatedDate?: string;
  category: string;
  image: string;
  imageAlt: string;
  imageLink?: string;
  readingTime: number;
  ctaUrl?: string;
  ctaText?: string;
  ctaButtonLabel: string;
  ctaType: "isca" | "produto" | "afiliado";
  related: { title: string; href: string; category: string }[];
}

const {
  title,
  description,
  author,
  pubDate,
  updatedDate,
  category,
  image,
  imageAlt,
  imageLink,
  readingTime,
  ctaUrl,
  ctaText,
  ctaButtonLabel,
  ctaType,
  related,
} = Astro.props;

const formattedDate = new Date(`${pubDate}T00:00:00`).toLocaleDateString(
  "pt-BR",
  {
    day: "2-digit",
    month: "long",
    year: "numeric",
  },
);

const formattedUpdated = updatedDate
  ? new Date(`${updatedDate}T00:00:00`).toLocaleDateString("pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : undefined;
---

<BaseLayout
  title={`${title} - Radar F5`}
  description={description}
  image={image}
  type="article"
>
  <header class="site-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>

        <span aria-hidden="true"> &gt; </span>

        <a href="/artigos/">Artigos</a>

        <span aria-hidden="true"> &gt; </span>

        <a href={categoryHref(category)}>{category}</a>
      </nav>

      <AdSlot position="top" />

      <h1 class="article-title">{title}</h1>

      <div class="meta-info">
        <span>
          Por
          <strong> {author}</strong>
        </span>

        <span>|</span>

        <time datetime={pubDate}>{formattedDate}</time>

        {
          formattedUpdated && (
            <>
              <span>|</span>
              <span class="updated-date">
                Atualizado em <time datetime={updatedDate}>{formattedUpdated}</time>
              </span>
            </>
          )
        }

        <span>|</span>

        <span id="reading-time">{readingTime} min de leitura</span>
      </div>
    </div>
  </header>

  <div class="container">
    <article class="main-article">
      <picture class="featured-image">
        {
          imageLink ? (
            <a href={imageLink} rel="sponsored noopener" target="_blank">
              <img
                src={image}
                alt={imageAlt}
                width="1200"
                height="675"
                fetchpriority="high"
              />
            </a>
          ) : (
            <img
              src={image}
              alt={imageAlt}
              width="1200"
              height="675"
              fetchpriority="high"
            />
          )
        }
      </picture>

      {imageLink && <p class="featured-image__disclosure">Link de afiliado — podemos ganhar uma comissão.</p>}

      <section class="article-body">
        <slot />
      </section>

      <ArticleCTA
        url={ctaUrl}
        text={ctaText}
        buttonLabel={ctaButtonLabel}
        type={ctaType}
      />

      <RelatedArticles items={related} />
    </article>
  </div>
</BaseLayout>
