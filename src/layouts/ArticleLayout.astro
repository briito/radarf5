---
import BaseLayout from "./BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";

interface AffiliateProduct {
  name: string;
  image: string;
  imageAlt?: string;
  price?: string;
  links: { label: string; url: string }[];
}

interface Props {
  title: string;
  description: string;
  author: string;
  pubDate: string;
  category: string;
  image: string;
  imageAlt: string;
  imageLink?: string;
  readingTime: number;
  affiliateProduct?: AffiliateProduct;
}

const {
  title,
  description,
  author,
  pubDate,
  category,
  image,
  imageAlt,
  imageLink,
  readingTime,
  affiliateProduct,
} = Astro.props;

const formattedDate = new Date(`${pubDate}T00:00:00`).toLocaleDateString(
  "pt-BR",
  {
    day: "2-digit",
    month: "long",
    year: "numeric",
  },
);
---

<BaseLayout
  title={`${title} - Radar F5`}
  description={description}
  image={image}
  type="article"
>
  <header class="site-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>

        <span aria-hidden="true"> &gt; </span>

        <a href="/artigos/">Artigos</a>

        <span aria-hidden="true"> &gt; </span>

        <span>{category}</span>
      </nav>

      <h1 class="article-title">{title}</h1>

      <div class="meta-info">
        <span>
          Por
          <strong>{author}</strong>
        </span>

        <span>|</span>

        <time datetime={pubDate}>{formattedDate}</time>

        <span>|</span>

        <span id="reading-time">{readingTime} min de leitura</span>
      </div>
    </div>
  </header>

  <div class="container">
    <article class="main-article">
      <picture class="featured-image">
        {
          imageLink ? (
            <a href={imageLink} rel="sponsored noopener" target="_blank">
              <img
                src={image}
                alt={imageAlt}
                width="1200"
                height="675"
                fetchpriority="high"
              />
            </a>
          ) : (
            <img
              src={image}
              alt={imageAlt}
              width="1200"
              height="675"
              fetchpriority="high"
            />
          )
        }
      </picture>

      {imageLink && <p class="featured-image__disclosure">Link de afiliado — podemos ganhar uma comissão.</p>}

      <section class="article-body">
        <slot />
      </section>

      <AdSlot position="end" affiliateProduct={affiliateProduct} />
    </article>
  </div>
</BaseLayout>
