---
// CTA simples de afiliado (Hotmart/Kiwify), pensado pra ser repetido em
// todos os artigos. Só renderiza se `url` estiver definido — sem link,
// não aparece nenhuma caixa vazia.
interface Props {
  url?: string;
  text: string;
  buttonLabel: string;
}

const { url, text, buttonLabel } = Astro.props;

// `text` pode vir com duas frases separadas por uma linha em branco
// (\n\n); cada uma vira um parágrafo próprio, com espaço entre elas.
const paragraphs = text.split("\n\n").filter(Boolean);
---

{
  url && (
    <div class="cta-box">
      {paragraphs.map((paragraph) => (
        <p class="cta-box__text">{paragraph}</p>
      ))}

      <a
        href={url}
        class="btn-cta"
        rel="sponsored noopener"
        target="_blank"
      >
        {buttonLabel}
      </a>

      <p class="cta-box__disclosure">
        Link de afiliado — podemos ganhar uma comissão.
      </p>
    </div>
  )
}
